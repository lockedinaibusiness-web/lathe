# Lathe local environment template. Copy to .env and fill in. NEVER commit .env.

# --- Core services (docker-compose defaults) ---
DATABASE_URL=postgres://lathe:lathe@localhost:5432/lathe
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MEDIA=lathe-media
S3_BUCKET_PROXIES=lathe-proxies
S3_BUCKET_RENDERS=lathe-renders
S3_FORCE_PATH_STYLE=true

# --- API ---
API_PORT=8080
API_HOST=127.0.0.1
API_LOG_LEVEL=info
# Local mode runs without Docker infra (in-memory repos, filesystem storage).
LATHE_LOCAL_MODE=auto

# --- Signed URL / media security ---
MEDIA_URL_TTL_SECONDS=900
SIGNING_SECRET=dev-only-change-me

# --- MCP / OAuth 2.1 (M6) ---
MCP_ISSUER_URL=http://127.0.0.1:8080
MCP_TOKEN_TTL_SECONDS=3600