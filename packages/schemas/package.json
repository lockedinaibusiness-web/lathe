{
  "name": "@lathe/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for Lathe contracts: Zod schemas -> JSON Schema + OpenAPI + MCP tool definitions.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen": "tsx scripts/generate.ts",
    "gen:check": "tsx scripts/generate.ts --check"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}