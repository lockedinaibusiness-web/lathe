{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/get-frames-response",
  "title": "GetFramesResponse",
  "description": "Signed frame URLs response.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "segment_id": {
            "type": "string",
            "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
            "description": "seg-prefixed stable ID, e.g. \"seg_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
          },
          "shot_id": {
            "type": "string",
            "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
            "description": "sht-prefixed stable ID, e.g. \"sht_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "t",
          "url",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "contact_sheet_url": {
      "type": "string",
      "format": "uri"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short human-readable summary for the model"
    }
  },
  "required": [
    "project_id",
    "frames",
    "summary"
  ],
  "additionalProperties": false
}
