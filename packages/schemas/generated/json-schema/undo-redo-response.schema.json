{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/undo-redo-response",
  "title": "UndoRedoResponse",
  "description": "Undo/redo result with new timeline version.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "reverted_op_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
        "description": "op-prefixed stable ID, e.g. \"op_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
      }
    },
    "group_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "grp-prefixed stable ID, e.g. \"grp_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "btc-prefixed stable ID, e.g. \"btc_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "new_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short human-readable summary for the model"
    }
  },
  "required": [
    "ok",
    "reverted_op_ids",
    "new_version",
    "summary"
  ],
  "additionalProperties": false
}
