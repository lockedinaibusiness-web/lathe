{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/job-envelope",
  "title": "JobEnvelope",
  "description": "Versioned job message to workers (TS <-> Python).",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "job-prefixed stable ID, e.g. \"job_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "type": {
      "type": "string",
      "enum": [
        "proxy.generate",
        "analysis.transcribe",
        "analysis.diarize",
        "analysis.shots",
        "analysis.audio_features",
        "analysis.embeddings",
        "analysis.visual",
        "preview.render",
        "render.full",
        "export.interchange",
        "export.captions",
        "verify.run"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Validated against the per-type payload schema"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "attempt": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_attempts": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "priority": {
      "default": 2,
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "trace": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "job_id",
    "contract_version",
    "type",
    "project_id",
    "payload",
    "idempotency_key",
    "attempt",
    "max_attempts",
    "priority",
    "created_at"
  ],
  "additionalProperties": false
}
