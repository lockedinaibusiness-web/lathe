{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/verify-fix-loop",
  "title": "VerifyFixLoopRequest",
  "description": "Auto-fix loop envelope (max 3 passes).",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "max_passes": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  },
  "required": [
    "project_id",
    "max_passes"
  ],
  "additionalProperties": false
}
