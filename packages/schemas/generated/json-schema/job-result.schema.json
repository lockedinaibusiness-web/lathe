{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/job-result",
  "title": "JobResultMessage",
  "description": "Worker completion message.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "job-prefixed stable ID, e.g. \"job_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "state": {
      "type": "string",
      "enum": [
        "completed",
        "failed"
      ]
    },
    "result": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wall_s": {
          "type": "number",
          "minimum": 0
        },
        "cpu_s": {
          "type": "number",
          "minimum": 0
        },
        "gpu_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "wall_s"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "job_id",
    "contract_version",
    "state"
  ],
  "additionalProperties": false
}
