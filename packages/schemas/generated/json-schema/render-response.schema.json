{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/render-response",
  "title": "RenderResponse",
  "description": "Render response with cache identity.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "job-prefixed stable ID, e.g. \"job_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "active",
        "completed",
        "failed"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "content_hash": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "cached": {
      "default": false,
      "description": "true when served from the render cache",
      "type": "boolean"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "full_reencode",
        "smart_render",
        "chunked_smart_render",
        "cached"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wall_s": {
          "type": "number",
          "minimum": 0
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggested_fix": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short human-readable summary for the model"
    }
  },
  "required": [
    "project_id",
    "job_id",
    "state",
    "cached",
    "summary"
  ],
  "additionalProperties": false
}
