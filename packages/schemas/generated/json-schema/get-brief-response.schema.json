                "description": "seg-prefixed stable ID, e.g. \"seg_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "speaker": {
                "type": "string",
                "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                "description": "spk-prefixed stable ID, e.g. \"spk_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
              },
              "text": {
                "type": "string"
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "w": {
                      "type": "string",
                      "minLength": 1
                    },
                    "s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "e": {
                      "type": "number",
                      "minimum": 0
                    },
                    "c": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "ASR confidence, 0..1"
                    }
                  },
                  "required": [
                    "w",
                    "s",
                    "e",
                    "c"
                  ],
                  "additionalProperties": false
                },
                "description": "Word-level timings; present once transcript is ready."
              },
              "shot_id": {
                "type": "string",
                "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                "description": "sht-prefixed stable ID, e.g. \"sht_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "filler",
                    "false_start",
                    "repeat",
                    "hook",
                    "topic_start",
                    "dead_air"
