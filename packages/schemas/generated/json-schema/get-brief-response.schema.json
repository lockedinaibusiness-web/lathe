                "description": "sht-prefixed stable ID, e.g. \"sht_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "faces": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
