            "silences": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "e": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "s",
                  "e"
                ],
                "additionalProperties": false
              }
            },
            "loudness_curve": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "t": {
                    "type": "number",
                    "minimum": 0
