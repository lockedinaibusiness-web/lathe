{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/get-brief-response",
  "title": "GetBriefResponse",
  "description": "Brief response with pending sections.",
  "x-lathe-contract-version": "1.0.0",
