{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/verify-fix-loop-response",
  "title": "VerifyFixLoopResponse",
  "description": "Fix-loop result across passes.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
            "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
          },
          "passed": {
            "type": "boolean"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                  "description": "fnd-prefixed stable ID, e.g. \"fnd_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "mid_word_cut",
                    "audio_click",
                    "clipping",
                    "loudness_off_target",
                    "true_peak_exceeded",
                    "caption_overflow",
                    "caption_too_fast",
                    "black_frames",
                    "av_drift",
                    "abrupt_level_jump",
                    "silence_over_budget",
                    "custom_check"
                  ]
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ]
                },
                "location": {
                  "type": "object",
                  "properties": {
                    "segment_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                        "description": "seg-prefixed stable ID, e.g. \"seg_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                      }
                    },
                    "shot_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                        "description": "sht-prefixed stable ID, e.g. \"sht_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                      }
                    },
                    "clip_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                        "description": "clp-prefixed stable ID, e.g. \"clp_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                      }
                    },
                    "caption_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                        "description": "cap-prefixed stable ID, e.g. \"cap_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                      }
                    },
                    "time_s": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "number",
                          "minimum": 0
                        },
                        "end": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "suggested_fix": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "auto_fixable": {
                  "type": "boolean"
                },
                "measured": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "threshold": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "value",
                    "threshold"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "code",
                "severity",
                "location",
                "message",
                "suggested_fix",
                "auto_fixable"
              ],
              "additionalProperties": false
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "audio": {
                "type": "object",
                "properties": {
                  "integrated_lufs": {
                    "type": "number"
                  },
                  "true_peak_dbtp": {
                    "type": "number"
                  },
                  "max_sample_level_db": {
                    "type": "number"
                  }
                },
                "required": [
                  "integrated_lufs",
                  "true_peak_dbtp"
                ],
                "additionalProperties": false
              },
              "pacing": {
                "type": "object",
                "properties": {
                  "speech_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "silence_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "longest_pause_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cuts_per_minute": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max_caption_cps": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "fix_pass": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Short human-readable summary for the model"
          }
        },
        "required": [
          "project_id",
          "passed",
          "findings",
          "metrics",
          "fix_pass",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "resolved": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short human-readable summary for the model"
    }
  },
  "required": [
    "project_id",
    "passes",
    "resolved",
    "summary"
  ],
  "additionalProperties": false
}
