{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/readyz-response",
  "title": "ReadyzResponse",
  "description": "Readiness payload (database/storage/queue).",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "database",
              "storage",
              "queue"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "checks"
  ],
  "additionalProperties": false
}
