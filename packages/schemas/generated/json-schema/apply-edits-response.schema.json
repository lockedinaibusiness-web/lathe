{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/apply-edits-response",
  "title": "ApplyEditsResponse",
  "description": "Per-operation results, snap reports, conflicts.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "btc-prefixed stable ID, e.g. \"btc_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "previous_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "new_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "applied": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op_id": {
            "type": "string",
            "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
            "description": "op-prefixed stable ID, e.g. \"op_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
          },
          "ok": {
            "type": "boolean"
          },
          "snap": {
            "type": "array",
            "items": {}
          },
          "created": {
            "type": "object",
            "properties": {
              "clip_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                  "description": "clp-prefixed stable ID, e.g. \"clp_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                }
              },
              "caption_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                  "description": "cap-prefixed stable ID, e.g. \"cap_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                }
              }
            },
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "suggested_fix": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "suggested_fix"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "op_id",
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "op_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
              "description": "op-prefixed stable ID, e.g. \"op_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
            }
          },
          "message": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "op_ids",
          "message",
          "suggested_fix"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short human-readable summary for the model"
    }
  },
  "required": [
    "batch_id",
    "project_id",
    "previous_version",
    "new_version",
    "applied",
    "results",
    "conflicts",
    "summary"
  ],
  "additionalProperties": false
}
