{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/project",
  "title": "Project",
  "description": "A project: workspace, timeline version, status.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "indexing",
        "ready",
        "failed"
      ]
    },
    "timeline_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "style_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "sty-prefixed stable ID, e.g. \"sty_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "created_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "timeline_version",
    "created_ms",
    "updated_ms"
  ],
  "additionalProperties": false
}
