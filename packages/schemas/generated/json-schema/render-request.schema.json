{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/render-request",
  "title": "RenderRequest",
  "description": "Full-quality render request.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "preset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "smart_render": {
      "default": true,
      "type": "boolean"
    },
    "wait": {
      "default": false,
      "type": "boolean"
    },
    "timeout_s": {
      "default": 120,
      "type": "number",
      "minimum": 1,
      "maximum": 600
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "description": "Invariant #4: safe to retry"
    }
  },
  "required": [
    "project_id",
    "preset_id",
    "smart_render",
    "wait",
    "timeout_s",
    "idempotency_key"
  ],
  "additionalProperties": false
}
