{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/search-footage-response",
  "title": "SearchFootageResponse",
  "description": "Search hits response.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "mode": {
      "type": "string",
      "enum": [
        "keyword",
        "semantic"
      ]
    },
    "hits": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "segment"
              },
              "segment": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                    "description": "seg-prefixed stable ID, e.g. \"seg_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "speaker": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                    "description": "spk-prefixed stable ID, e.g. \"spk_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                  },
                  "text": {
                    "type": "string"
                  },
                  "words": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "w": {
                          "type": "string",
                          "minLength": 1
                        },
                        "s": {
                          "type": "number",
                          "minimum": 0
                        },
                        "e": {
                          "type": "number",
                          "minimum": 0
                        },
                        "c": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "ASR confidence, 0..1"
                        }
                      },
                      "required": [
                        "w",
                        "s",
                        "e",
                        "c"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Word-level timings; present once transcript is ready."
                  },
                  "shot_id": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                    "description": "sht-prefixed stable ID, e.g. \"sht_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "filler",
                        "false_start",
                        "repeat",
                        "hook",
                        "topic_start",
                        "dead_air"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "start_s",
                  "end_s",
                  "speaker",
                  "text",
                  "words"
                ],
                "additionalProperties": false
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "matched_words": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "segment",
              "score",
              "matched_words"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "shot"
              },
              "shot": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
                    "description": "sht-prefixed stable ID, e.g. \"sht_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "faces": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "ocr": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "activity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "id",
                  "start_s",
                  "end_s"
                ],
                "additionalProperties": false
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "shot",
              "score"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short human-readable summary for the model"
    },
    "notice": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "mode",
    "hits",
    "summary"
  ],
  "additionalProperties": false
}
