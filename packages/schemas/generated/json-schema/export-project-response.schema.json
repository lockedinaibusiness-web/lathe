{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/export-project-response",
  "title": "ExportProjectResponse",
  "description": "Export response with signed URL.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "format": {
      "type": "string",
      "enum": [
        "otio",
        "fcpxml",
        "edl",
        "srt",
        "vtt",
        "json"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "job-prefixed stable ID, e.g. \"job_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short human-readable summary for the model"
    }
  },
  "required": [
    "project_id",
    "format",
    "url",
    "filename",
    "summary"
  ],
  "additionalProperties": false
}
