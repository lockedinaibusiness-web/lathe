{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/export-project-request",
  "title": "ExportProjectRequest",
  "description": "OTIO/FCPXML/EDL/SRT/VTT export request.",
  "x-lathe-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Za-z0-9]{10,64}$",
      "description": "prj-prefixed stable ID, e.g. \"prj_01J8ZQ4K2M9T3X7YB6N0PWABCD\""
    },
    "format": {
      "type": "string",
      "enum": [
        "otio",
        "fcpxml",
        "edl",
        "srt",
        "vtt",
        "json"
      ]
    },
    "caption_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "format"
  ],
  "additionalProperties": false
}
